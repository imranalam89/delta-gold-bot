# Rithmic Market Data (CME Gold GC Feed)
RITHMIC_USER="your_rithmic_user_id"
RITHMIC_PASS="your_rithmic_password"
RITHMIC_SYSTEM="Apex"  # e.g. Apex, Topstep, Rithmic Paper Trading, MyFundedFutures

# Tradovate CME Market Data (Alternative)
# If using an API key generated from Tradovate Settings -> API:
TRADOVATE_USER="YOUR_TRADOVATE_USERNAME"
TRADOVATE_PASS="YOUR_TRADOVATE_PASSWORD"
TRADOVATE_APP_ID="SampleApp"
TRADOVATE_CID="0"      # Your Client ID (CID) from Tradovate API portal (or 0)
TRADOVATE_SEC=""       # Your API Secret (SEC) from Tradovate API portal
TRADOVATE_ENV="live"   # "live" for funded live account, "demo" for simulation

# Delta Exchange India (Execution Account 74634658)
DELTA_API_KEY="YOUR_DELTA_API_KEY"
DELTA_API_SECRET="YOUR_DELTA_API_SECRET"
DELTA_ACCOUNT_ID="74634658"

# Server Port (Dedicated port 5055 for new agents, leaves 5050 untouched)
PORT=5055
